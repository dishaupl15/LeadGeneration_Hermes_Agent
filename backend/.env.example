# ─────────────────────────────────────────────────────────────────────────────
#  Lead Generation CRM – environment variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Lead Generation CRM"
APP_VERSION="1.0.0"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002

# ── CORS – comma-separated list of allowed frontend origins ──────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/crm

# ── Lead Generation API Keys (REQUIRED) ──────────────────────────────────────
# Get your free key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Get your free key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ── Waterfall Enrichment API Keys (optional — each is an independent fallback) ─
# If a key is missing the provider is simply skipped; the pipeline still works.

# Hunter.io — primary email discovery + verification
# Free tier: 25 searches/month  https://hunter.io/api-documentation
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io — email, founder, phone enrichment (fallback)
# Free tier: 50 credits/month  https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# People Data Labs — founder/CEO identification (primary)
# https://dashboard.peopledatalabs.com
PDL_API_KEY=your_pdl_api_key_here

# Google Maps Platform — phone + address via Places API (New)  (primary)
# Enable "Places API (New)" at https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
