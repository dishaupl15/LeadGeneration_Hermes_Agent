# ─────────────────────────────────────────────────────────────────────────────
#  Lead Generation CRM – environment variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Lead Generation CRM"
APP_VERSION="1.0.0"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001

# ── CORS – comma-separated list of allowed frontend origins ──────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/crm

# ── leadgen.py path (optional — override if not at the default location) ─────
# LEADGEN_SCRIPT=C:\Users\YourName\LeadGeneration\tools\leadgen.py
