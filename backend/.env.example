# ─────────────────────────────────────────────────────────────────────────────
#  Lead Generation CRM – environment variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Lead Generation CRM"
APP_VERSION="1.0.0"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002

# ── CORS – comma-separated list of allowed frontend origins ──────────────────
# Add your machine's local network IP so devices on the same Wi-Fi can reach
# the backend when they open a tracking link on their phone/tablet.
# Find your IP: run  ipconfig  (Windows) or  ifconfig  (Mac/Linux)
#
# Development (local network):
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_LOCAL_IP:5173
# Production: set to your deployed frontend domain — do NOT use localhost here
#   CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN.com
#
# Multiple origins are comma-separated:
#   CORS_ORIGINS=https://myapp.vercel.app,https://www.myapp.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_LOCAL_IP:5173,http://YOUR_LOCAL_IP:5174

# ── Public Form Base URL ──────────────────────────────────────────────────────
# Base URL of the FRONTEND — used to build shareable public form links.
# Anyone who opens this URL must be able to reach your frontend.
# This is the URL stored in the database for every campaign's tracking_url.
#
# Development (local Wi-Fi):
#   PUBLIC_FORM_BASE_URL=http://192.168.1.42:5173
# Production (REQUIRED — do NOT use localhost or a private IP):
#   PUBLIC_FORM_BASE_URL=https://YOUR-FRONTEND-DOMAIN.com
#
# Generated public URL format: {PUBLIC_FORM_BASE_URL}/f/{form_id}
# When empty, falls back to the backend request URL (fine for bare localhost dev).
PUBLIC_FORM_BASE_URL=http://YOUR_LOCAL_IP:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas (REQUIRED — set your Atlas connection string here):
#   Replace <USERNAME> and <PASSWORD> with your Atlas database user credentials.
#   Keep ?appName=Cluster0 at the end.
MONGODB_URI=

# ── Lead Generation API Keys (REQUIRED) ──────────────────────────────────────
# Get your free key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Get your free key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# CompanyEnrich — optional fallback enrichment for company-level details
# https://docs.companyenrich.com/
COMPANYENRICH_API_KEY=

# ── Waterfall Enrichment API Keys (optional — each is an independent fallback) ─
# If a key is missing the provider is simply skipped; the pipeline still works.

# Hunter.io — primary email discovery + verification
# Free tier: 25 searches/month  https://hunter.io/api-documentation
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io — email, founder, phone enrichment (fallback)
# Free tier: 50 credits/month  https://app.apollo.io/#/settings/integrations/api


# People Data Labs — founder/CEO identification (primary)
# https://dashboard.peopledatalabs.com
PDL_API_KEY=your_pdl_api_key_here
PDL_MAX_CONTACTS_PER_COMPANY=5
PDL_TIMEOUT_SECONDS=15

# Google Maps Platform — Google Places API (New)
# Used exclusively by the isolated google_maps/ module (POST /maps-leads/generate)
# Enable "Places API (New)" at https://console.cloud.google.com/
# Billing must be enabled on the project.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Prospeo — People Enrichment (standalone module) ───────────────────────────
# Sign up and get your API key at https://prospeo.io
PROSPEO_API_KEY=your_prospeo_api_key_here
PROSPEO_MAX_CONTACTS_PER_COMPANY=2
PROSPEO_TIMEOUT_SECONDS=15

# ── ContactOut — People Enrichment (standalone module) ────────────────────────
# Get your token at https://app.contactout.com/settings/api
CONTACTOUT_API_TOKEN=your_contactout_api_token_here
CONTACTOUT_MAX_CONTACTS_PER_COMPANY=2
CONTACTOUT_TIMEOUT_SECONDS=15

# ── Origami — Optional Decision-Maker Enrichment (standalone module) ──────────
# Origami finds founders, CEOs, directors and other decision-makers for a company.
# It runs BEFORE the PDL/Prospeo/ContactOut waterfall as an additional layer.
# If ORIGAMI_API_KEY is not set the module is silently skipped — the existing
# pipeline continues without any change.
# Get your key at https://origami.ai (or your Origami dashboard).
ORIGAMI_API_KEY=
ORIGAMI_BASE_URL=https://api.origami.ai/v1
ORIGAMI_TIMEOUT_SECONDS=20
ORIGAMI_MAX_CONTACTS=5

# ── Reddit Lead Generation (standalone module) ────────────────────────────────
# Create a Reddit "script" app at https://www.reddit.com/prefs/apps
#   Type: script  (application-only OAuth2 — no user login required)
# Copy the client_id (shown below the app name) and client_secret.
# Set a descriptive user_agent that identifies your app per Reddit policy.
# If these are not set the Reddit module is silently skipped — Google Maps
# lead generation continues without any change.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=LeadCRM-RedditModule/1.0 by YourRedditUsername
REDDIT_REQUEST_TIMEOUT=15
REDDIT_MAX_POSTS=25
REDDIT_MAX_QUERIES=6
