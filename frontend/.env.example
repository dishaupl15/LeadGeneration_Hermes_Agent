# ─────────────────────────────────────────────────────────────────────────────
#  Frontend environment variables — copy to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API base URL ──────────────────────────────────────────────────────
# Points the frontend at the FastAPI backend.
#
# Development (local network):
#   VITE_API_URL=http://192.168.1.42:8002    ← find your IP with: ipconfig (Win)
# Production:
#   VITE_API_URL=https://YOUR-BACKEND-DOMAIN.com
#
# Falls back to http://localhost:8002 when not set (only works on this machine).
VITE_API_URL=http://YOUR_LOCAL_IP:8002

# ── Public form base URL ──────────────────────────────────────────────────────
# The base URL where the FRONTEND is publicly accessible.
# Used to generate shareable form links shown in the CRM (e.g. the "Public URL"
# bar, "Open Form" button, and all tracking links).
#
# Development (local network):
#   VITE_PUBLIC_FORM_BASE_URL=http://192.168.1.42:5173
# Production:
#   VITE_PUBLIC_FORM_BASE_URL=https://YOUR-FRONTEND-DOMAIN.com
#
# Falls back to window.location.origin when not set — fine for local dev,
# but MUST be set in production so the CRM shows the correct public URL
# regardless of which machine/browser opens the CRM.
VITE_PUBLIC_FORM_BASE_URL=http://YOUR_LOCAL_IP:5173
