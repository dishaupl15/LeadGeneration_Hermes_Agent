# ─────────────────────────────────────────────────────────────────────────────
#  Frontend environment variables — copy to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API base URL ──────────────────────────────────────────────────────
# Points the frontend at the FastAPI backend.
#
# Development (same machine): VITE_API_URL=http://localhost:8002
# Production:                 VITE_API_URL=https://api.your-domain.com
#
# Falls back to http://<same-hostname>:8002 when not set — this is the safe
# default for local development and does NOT need to be changed unless your
# backend is on a different host/domain.
VITE_API_URL=http://localhost:8002

# ── Public App URL ────────────────────────────────────────────────────────────
# The URL where the FRONTEND is publicly accessible.
# Used to generate shareable form links shown in the CRM
# (the "Public URL" bar, "Copy Link" button, and all tracking links).
#
# Development: LEAVE THIS EMPTY.
#   The app auto-detects window.location.origin at runtime.
#   Public links will use whatever hostname/IP the CRM page is opened from.
#   This works from localhost AND from any LAN IP without any .env changes.
#
# Production (REQUIRED — set this before deploying):
#   VITE_PUBLIC_APP_URL=https://your-frontend-domain.com
#
# Do NOT set this to a private IP (10.x.x.x, 192.168.x.x) in production.
# Do NOT hardcode localhost here for production builds.
# Generated public URL format: {VITE_PUBLIC_APP_URL}/f/{form_id}
VITE_PUBLIC_APP_URL=
